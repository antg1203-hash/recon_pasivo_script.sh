#!/bin/bash
# passive_recon.sh - Passive domain reconnaissance
# Usage: ./passive_recon.sh domain.com

set -euo pipefail  # -e: exit on error, -u: error if var undefined, -o pipefail: detect errors in pipes

# Argument validation
if [ $# -ne 1 ]; then
    echo "❌ Usage: $0 <domain>"
    echo "Example: $0 example.com"
    exit 1
fi

DOMAIN=$1

# Validate domain format
if [[ ! $DOMAIN =~ ^[a-zA-Z0-9.-]+$ ]]; then
    echo "❌ Error: Invalid domain '$DOMAIN'"
    echo "Domain must contain only letters, numbers, dots and hyphens"
    exit 1
fi

OUTPUT_DIR="recon_$DOMAIN"
LOG_FILE="$OUTPUT_DIR/recon.log"

# Create directory
mkdir -p "$OUTPUT_DIR"

echo "[*] Starting reconnaissance for $DOMAIN..." | tee "$LOG_FILE"

# Check for required tools
if ! command -v waybackurls &> /dev/null; then
    echo "❌ Error: 'waybackurls' not installed. Install with: go install github.com/tomnomnom/waybackurls@latest"
    exit 1
fi

# 1. Extract robots.txt
echo "[*] Extracting robots.txt..." | tee -a "$LOG_FILE"
if curl -sfL "https://$DOMAIN/robots.txt" > "$OUTPUT_DIR/robots.txt" 2>/dev/null; then
    echo "✓ robots.txt downloaded" | tee -a "$LOG_FILE"
else
    echo "⚠ Could not retrieve robots.txt" | tee -a "$LOG_FILE"
fi

# 2. Historical URLs
echo "[*] Searching for historical URLs..." | tee -a "$LOG_FILE"
if waybackurls "$DOMAIN" | sort -u > "$OUTPUT_DIR/wayback.txt" 2>/dev/null; then
    WAYBACK_COUNT=$(wc -l < "$OUTPUT_DIR/wayback.txt")
    echo "✓ $WAYBACK_COUNT URLs found in Wayback Machine" | tee -a "$LOG_FILE"
else
    echo "⚠ No URLs retrieved from Wayback" | tee -a "$LOG_FILE"
fi

# 3. Filter sensitive endpoints
echo "[*] Filtering sensitive endpoints..." | tee -a "$LOG_FILE"
if [ -s "$OUTPUT_DIR/wayback.txt" ]; then
    if grep -iE "api|admin|backup|config|db|debug|internal|secret|key|password|token" \
        "$OUTPUT_DIR/wayback.txt" > "$OUTPUT_DIR/endpoints.txt" 2>/dev/null; then
        ENDPOINTS_COUNT=$(wc -l < "$OUTPUT_DIR/endpoints.txt")
        echo "✓ $ENDPOINTS_COUNT sensitive endpoints found" | tee -a "$LOG_FILE"
    else
        echo "⚠ No sensitive endpoints found" | tee -a "$LOG_FILE"
    fi
else
    echo "⚠ wayback.txt empty - no URLs to analyze" | tee -a "$LOG_FILE"
fi

# Summary
echo "" | tee -a "$LOG_FILE"
echo "[+] ✅ Reconnaissance completed in $OUTPUT_DIR" | tee -a "$LOG_FILE"
echo "[+] Generated files:" | tee -a "$LOG_FILE"
ls -lh "$OUTPUT_DIR" | tail -n +2 | awk '{print "    " $9 " (" $5 ")"}' | tee -a "$LOG_FILE"
