#!/bin/bash
# recon_pasivo.sh - Reconocimiento pasivo de dominios
# Uso: ./recon_pasivo.sh dominio.com

set -euo pipefail  # -e: salir si hay error, -u: error si variable no existe, -o pipefail: detectar errores en pipes

# Validación de argumentos
if [ $# -ne 1 ]; then
    echo "❌ Uso: $0 <dominio>"
    echo "Ejemplo: $0 example.com"
    exit 1
fi

DOMAIN=$1

# Validar formato del dominio
if [[ ! $DOMAIN =~ ^[a-zA-Z0-9.-]+$ ]]; then
    echo "❌ Error: Dominio inválido '$DOMAIN'"
    echo "El dominio debe contener solo letras, números, puntos y guiones"
    exit 1
fi

OUTPUT_DIR="recon_$DOMAIN"
LOG_FILE="$OUTPUT_DIR/recon.log"

# Crear directorio
mkdir -p "$OUTPUT_DIR"

echo "[*] Iniciando reconocimiento de $DOMAIN..." | tee "$LOG_FILE"

# Verificar herramientas necesarias
if ! command -v waybackurls &> /dev/null; then
    echo "❌ Error: 'waybackurls' no instalado. Instala con: go install github.com/tomnomnom/waybackurls@latest"
    exit 1
fi

# 1. Extrae robots.txt
echo "[*] Extrayendo robots.txt..." | tee -a "$LOG_FILE"
if curl -sfL "https://$DOMAIN/robots.txt" > "$OUTPUT_DIR/robots.txt" 2>/dev/null; then
    echo "✓ robots.txt descargado" | tee -a "$LOG_FILE"
else
    echo "⚠ No se pudo obtener robots.txt" | tee -a "$LOG_FILE"
fi

# 2. URLs históricas
echo "[*] Buscando URLs históricas..." | tee -a "$LOG_FILE"
if waybackurls "$DOMAIN" | sort -u > "$OUTPUT_DIR/wayback.txt" 2>/dev/null; then
    WAYBACK_COUNT=$(wc -l < "$OUTPUT_DIR/wayback.txt")
    echo "✓ $WAYBACK_COUNT URLs encontradas en Wayback Machine" | tee -a "$LOG_FILE"
else
    echo "⚠ No se obtuvieron URLs del Wayback" | tee -a "$LOG_FILE"
fi

# 3. Filtrar endpoints sensibles
echo "[*] Filtrando endpoints sensibles..." | tee -a "$LOG_FILE"
if [ -s "$OUTPUT_DIR/wayback.txt" ]; then
    if grep -iE "api|admin|backup|config|db|debug|internal|secret|key|password|token" \
        "$OUTPUT_DIR/wayback.txt" > "$OUTPUT_DIR/endpoints.txt" 2>/dev/null; then
        ENDPOINTS_COUNT=$(wc -l < "$OUTPUT_DIR/endpoints.txt")
        echo "✓ $ENDPOINTS_COUNT endpoints sensibles encontrados" | tee -a "$LOG_FILE"
    else
        echo "⚠ Sin endpoints sensibles encontrados" | tee -a "$LOG_FILE"
    fi
else
    echo "⚠ wayback.txt vacío - no hay URLs para analizar" | tee -a "$LOG_FILE"
fi

# Resumen
echo "" | tee -a "$LOG_FILE"
echo "[+] ✅ Reconocimiento completado en $OUTPUT_DIR" | tee -a "$LOG_FILE"
echo "[+] Archivos generados:" | tee -a "$LOG_FILE"
ls -lh "$OUTPUT_DIR" | tail -n +2 | awk '{print "    " $9 " (" $5 ")"}' | tee -a "$LOG_FILE"
